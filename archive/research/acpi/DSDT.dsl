    Scope (_SB)
    {
        Device (ASHS)
        {
            Name (_HID, "ATK4002")  // _HID: Hardware ID
            Method (HSWC, 1, Serialized)
            {
                If ((Arg0 < 0x02))
                {
                    OWGD (Arg0)
                    Return (One)
                }

                If ((Arg0 == 0x02))
                {
                    Local0 = OWGS ()
                    If (Local0)
                    {
                        Return (0x04)
                    }
                    Else
                    {
                        Return (0x05)
                    }
                }

                If ((Arg0 == 0x03))
                {
                    Return (OHWS ())
                }

                If ((Arg0 == 0x04))
                {
                    OWGD (Zero)
                    Return (One)
                }

                If ((Arg0 == 0x05))
                {
                    OWGD (One)
                    Return (One)
                }

                If ((Arg0 == 0x80))
                {
                    Return (One)
                }
            }

            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                If ((OSYS >= 0x07DC))
                {
                    Return (0x0F)
                }
                Else
                {
                    Return (Zero)
                }
            }

            Method (OWGD, 1, NotSerialized)
            {
                ^^ATKD.WLED (Arg0)
                ^^ATKD.BLED (Arg0)
                ^^ATKD.WMXC (Arg0)
            }

            Method (OWGS, 0, NotSerialized)
            {
                Local0 = Zero
                If (^^PC00.LPCB.EC0.ECOK)
                {
                    Acquire (^^PC00.LPCB.EC0.MUT0, 0x03E8)
                    Local1 = ^^PC00.LPCB.EC0.WLRF /* \_SB_.PC00.LPCB.EC0_.WLRF */
                    Release (^^PC00.LPCB.EC0.MUT0)
                    If ((Local1 == One))
                    {
                        Local0 |= One
                    }
                }

                Return (Local0)
            }

            Method (OHWS, 0, NotSerialized)
            {
                Return (0xFF)
            }
        }
    }

    Scope (_SB.PC00.LPCB.EC0)
    {
    }

    Scope (_SB.PC00.LPCB.EC0)
    {
        Method (SKEY, 1, Serialized)
        {
            Switch (Arg0)
            {
                Case (0x86)
                {
                    ^^^^ATKD.MAKY ()
                }
                Case (0x6C)
                {
                    _Q31 ()
                }
                Case (0x88)
                {
                    _QAF ()
                }
                Case (0xC5)
                {
                    _Q76 ()
                }
                Case (0xC4)
                {
                    _Q77 ()
                }
                Case (0x6B)
                {
                    _Q22 ()
                }
                Case (0x8A)
                {
                    _QB0 ()
                }
                Case (0xB5)
                {
                    _QB8 ()
                }
                Case (0x7C)
                {
                    _Q21 ()
                }
                Case (0x99)
                {
                    _QB5 ()
                }
                Case (0x9E)
                {
                    _QB1 ()
                }
                Case (0xB2)
                {
                    _QAC ()
                }
                Case (0xB3)
                {
                    _QAD ()
                }
                Case (0xAE)
                {
                    _QB5 ()
                }
                Case (0xCF)
                {
                    _QD9 ()
                }
                Default
                {
                    Return (Zero)
                }

            }

            Return (One)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (CRFC, 0, NotSerialized)
        {
            Name (PSSI, Zero)
            Name (FREQ, Zero)
            Local0 = Package (0x0A)
                {
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero, 
                    Zero
                }
            If ((OSCP & 0x0400))
            {
                PSSI = SizeOf (^^PR00.TPSS)
            }
            Else
            {
                PSSI = SizeOf (^^PR00.LPSS)
            }

            FREQ = DerefOf (DerefOf (^^PR00.TPSS [Zero]) [Zero])
            Local0 [0x04] = FREQ /* \_SB_.ATKD.CRFC.FREQ */
            PSSI--
            FREQ = DerefOf (DerefOf (^^PR00.TPSS [PSSI]) [Zero])
            Local0 [0x06] = FREQ /* \_SB_.ATKD.CRFC.FREQ */
            Return (Local0)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (FANL, 1, Serialized)
        {
            Return (One)
        }

        Method (GQFS, 0, NotSerialized)
        {
            Return (0x00020000)
        }
    }

    Scope (_SB.ATKD)
    {
        Method (MAKY, 0, NotSerialized)
        {
            Return (Zero)
        }

        Method (BSTS, 0, NotSerialized)
        {
            If (ACPF)
            {
                Local0 = Zero
            }
            Else
            {
                Local0 = Zero
            }

            Return (Local0)
        }

        Method (WDOG, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (WLED, 1, NotSerialized)
        {
            Arg0 &= One
            If (^^PC00.LPCB.EC0.ECOK)
            {
                Acquire (^^PC00.LPCB.EC0.MUT0, 0x1000)
                If ((Arg0 == One))
                {
                    ^^PC00.LPCB.EC0.WLRF = One
                }
                Else
                {
                    ^^PC00.LPCB.EC0.WLRF = Zero
                }

                Release (^^PC00.LPCB.EC0.MUT0)
            }
            Else
            {
                Return (Zero)
            }

            Return (One)
        }

        Method (BLED, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (WMXC, 1, NotSerialized)
        {
            Return (Zero)
        }

        Method (OWGD, 1, Serialized)
        {
            If (^^PC00.LPCB.EC0.ECOK)
            {
                Acquire (^^PC00.LPCB.EC0.MUT0, 0x03E8)
                If ((Arg0 == Zero))
                {
                    ^^PC00.LPCB.EC0.WLRF = Zero
                }
                ElseIf ((Arg0 == One))
                {
                    ^^PC00.LPCB.EC0.WLRF = One
                }
                ElseIf ((Arg0 == 0x04))
                {
                    ^^PC00.LPCB.EC0.WLRF = Zero
                }
                ElseIf ((Arg0 == 0x05))
                {
                    ^^PC00.LPCB.EC0.WLRF = One
                }

                Release (^^PC00.LPCB.EC0.MUT0)
            }
        }
    }

    Scope (_SB.ATKD)
    {
        Method (WCHK, 2, Serialized)
        {
            WNVA = 0x9603
            WNVB = One
            WNVC = Arg1
            WNVD = Arg0
            Return (W15H ())
        }
    }

